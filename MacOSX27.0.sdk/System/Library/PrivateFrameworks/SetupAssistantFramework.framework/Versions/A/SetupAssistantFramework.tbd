--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
install-name:    '/System/Library/PrivateFrameworks/SetupAssistantFramework.framework/Versions/A/SetupAssistantFramework'
exports:
  - targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
    symbols:         [ _SAFacelessConfigurationErrorDomain, _SetupAssistantFrameworkVersionNumber, 
                       _SetupAssistantFrameworkVersionString, _kMBSetupUserUID, _kSetupAssistantWindowDataKey, 
                       _kSetupAssistantWindowScreenNumberKey, _kSetupAssistantWindowXPositionKey, 
                       _kSetupAssistantWindowYPositionKey, _kSetupCompletedNotificationName ]
    objc-classes:    [ SACookieHandling, SAFacelessConfiguration, SAFacelessUserConfiguration, 
                       SALanguageCookieHandler, SALaunchController, SALauncher, SAPasswordPolicy, 
                       SASetupOverrideClient, SASoftwareUpdateManager, SAUserSetupState ]
...
