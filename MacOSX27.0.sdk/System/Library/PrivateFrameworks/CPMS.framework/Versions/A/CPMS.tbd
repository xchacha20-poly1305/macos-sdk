--- !tapi-tbd
tbd-version:     4
targets:         [ arm64e-macos, arm64e.x1-macos ]
install-name:    '/System/Library/PrivateFrameworks/CPMS.framework/Versions/A/CPMS'
exports:
  - targets:         [ arm64e-macos, arm64e.x1-macos ]
    symbols:         [ _CPMSErrorDomain, _kCPMSMaxPolicyPower, _kCPMSMinPolicyPower, 
                       _kCPMSPowerTimeScale100ms, _kCPMSPowerTimeScale1s, _kCPMSPowerTimeScaleInstantaneous, 
                       _kCPMSPowerTimeScaleThermal, _kPPMBatteryModelStepBaseDurationStr, 
                       _kPPMBatteryModelStepBaseStr, _kPPMBatteryModelStepPulseDurationStr, 
                       _kPPMBatteryModelStepPulseStr, _kPPMBatteryModelStepSpikeDurationStr, 
                       _kPPMBatteryModelStepSpikeStr, _kPPMBatteryModelStepUVLODurationStr, 
                       _kPPMBatteryModelStepUVLOStr, _suppressAssert ]
    objc-classes:    [ CPMSAgent, CPMSClientDescription, CPMSStateReader ]
...
