--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
install-name:    '/System/Library/PrivateFrameworks/AccessorySensorManagerDarwin_Private.framework/Versions/A/AccessorySensorManagerDarwin_Private'
allowable-clients:
  - targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
    clients:         [ ASMAccessoryIndicatorStatus, ASMAccessoryIndicatorStatusComponent, 
                       ASMExclaveDefines_Private, ASMExclaveSupport, ASMExclaveSupportTests, 
                       ASMInternalServices, ASMSSERetryPolicyTests, AWAudioProductService, 
                       AccessorySensorManagerAOEConsumerComponent, AccessorySensorManagerDarwin_Private, 
                       AccessorySensorManagerDefines_Private, AccessorySensorManagerExclaveDaemon, 
                       AccessorySensorManagerExclaveTests, AccessorySensorManagerMacros, 
                       AccessorySensorManagerMacrosHost, AccessorySensorManagerServices, 
                       AccessorySensorManagerTests, AccessorySensorManagerUserNotifications, 
                       accessorysensormgrd, asmdutil ]
exports:
  - targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
    objc-classes:    [ ASMImageProcessingHelper, ASMPolarisResourceProvider, ASMPowerAssertion, 
                       ASMSignpost ]
...
