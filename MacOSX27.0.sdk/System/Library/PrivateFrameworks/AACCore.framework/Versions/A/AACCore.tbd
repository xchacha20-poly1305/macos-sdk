--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, x86_64-maccatalyst, arm64e-macos, arm64e-maccatalyst, 
                   arm64e.x1-macos, arm64e.x1-maccatalyst ]
install-name:    '/System/Library/PrivateFrameworks/AACCore.framework/Versions/A/AACCore'
current-version: 0
compatibility-version: 0
exports:
  - targets:         [ x86_64-macos, x86_64-maccatalyst, arm64e-macos, arm64e-maccatalyst, 
                       arm64e.x1-macos, arm64e.x1-maccatalyst ]
    symbols:         [ _AACLoggingSubsystem, _AEAssessmentActiveRestrictionUUIDFetchingMachServiceName, 
                       _AEAssessmentModeEntitlement, _AEAssessmentModeFetchActiveRestrictionUUIDEntitlement, 
                       _AEAssessmentModeLegacyEntitlement, _AEAssessmentModePrivateConfigurationSPIEntitlement, 
                       _AEAssessmentPreferenceDomain, _AEAssessmentSessionExpirationTimeInSeconds, 
                       _AEAssessmentStateDidChangeNotificationName, _AEAssessmentStatePublisherRegisteringMachServiceName, 
                       _AEAssessmentUIServiceName, _AECalculatorBasicModeEnabledKey, 
                       _AECalculatorBundleIdentifier, _AECalculatorKeyboardMathSolvingEnabledKey, 
                       _AECalculatorMathPaperModeEnabledKey, _AECalculatorMathPaperSolvingEnabledKey, 
                       _AECalculatorProgrammerModeEnabledKey, _AECalculatorRPNInputModeEnabledKey, 
                       _AECalculatorScientificModeEnabledKey, _AECalculatorSquareRootOnBasicForcedKey, 
                       _AECalculatorUnitConversionInputModeEnabledKey, _AECoreError, 
                       _AECoreErrorDomain, _AECoreErrorUserInfo, _AECoreNotAliveParticipantPIDsKey, 
                       _AECoreNotInstalledParticipantsKey, _AECoreRestrictedSystemParticipantsKey, 
                       _AEIsAssessmentModeAvailableForDeviceType, _AEIsMultiAppAvailableForDeviceType, 
                       _AEKillAssessmentAgentNotificationName, _AELocalizedStringFromTableInBundle, 
                       _AEPolicySessionFailedToActivateSubsystemsKey, _AEPolicySessionFailedToDeactivateSubsystemsKey, 
                       _AEPreferencesDidChangeNotificationName ]
    objc-classes:    [ AEActivePolicySession, AEActiveRestrictionUUIDFetchingProxy, 
                       AEActiveRestrictionUUIDFetchingXPCInterfaceFactory, AEAssessmentAgentService, 
                       AEAssessmentApplicationDescriptor, AEAssessmentIndividualConfiguration, 
                       AEAssessmentModeGestalt, AEAssessmentModeRestrictionEnforcerProxy, 
                       AEAssessmentState, AEAssessmentStatePublishingProxy, AEAssessmentStatePublishingXPCInterfaceFactory, 
                       AEAssessmentStateSourceRegisteringProxy, AEAssessmentStateSourceRegisteringXPCInterfaceFactory, 
                       AEAssessmentUIConfiguration, AEAssessmentUIServiceProxy, AEAssessmentUIServiceXPCInterfaceFactory, 
                       AEConcretePreferencePrimitives, AEConcreteSystemNotificationPrimitives, 
                       AECoreMenuBarItem, AEDevicePrimitivesProvider, AEFeatureFlagsProvider, 
                       AEFileSystem, AELifecycleEventHandlingProxy, AELifecycleEventHandlingXPCInterfaceFactory, 
                       AELocalizedErrorDescriptions, AEOSGestalt, AEOptionMirror, 
                       AEPerformancePrimitivesProvider, AEPolicyBundle, AEPreference, 
                       AEPreferences, AEProcessInfoPrimitivesProvider, AESystemNotificationObservation ]
...
