--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, x86_64-maccatalyst, arm64e-macos, arm64e-maccatalyst, 
                   arm64e.x1-macos, arm64e.x1-maccatalyst ]
install-name:    '/System/Library/PrivateFrameworks/AudioServerApplication.framework/Versions/A/AudioServerApplication'
exports:
  - targets:         [ x86_64-macos, x86_64-maccatalyst, arm64e-macos, arm64e-maccatalyst, 
                       arm64e.x1-macos, arm64e.x1-maccatalyst ]
    objc-classes:    [ ASAAggregateDevice, ASAAudioDevice, ASAAudioFormat, ASABooleanControl, 
                       ASABox, ASAClockDevice, ASAControl, ASACoreAudio, ASALevelControl, 
                       ASAObject, ASAPlaythrough, ASAPlugin, ASASampleRateRange, 
                       ASASelectorControl, ASASliderControl, ASAStereoPanControl, 
                       ASAStream ]
...
