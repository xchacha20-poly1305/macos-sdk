                       ULConfiguration, ULConnection, ULContextLayerUtilities, ULCoordinate, 
                       ULCustomLoiConfiguration, ULDevicePredictionContext, ULFingerprintMetaInfo, 
                       ULHomeSlamModelData, ULLabel, ULLabelHomeKitUserInteraction, 
                       ULLabelWiFi, ULLocationOfInterest, ULLocationType, ULMap, 
                       ULMapItem, ULMapPeripheralData, ULMapPoint, ULMapROI, ULMapTrajectoryPoint, 
                       ULOccupancyData, ULOccupancyMapPoint, ULPlace, ULPrediction, 
                       ULPredictionContext, ULRoomBoundaryPolygon, ULServiceDescriptor, 
                       ULServiceMetaInfo, ULServiceQualityInfo, ULServiceQualityReason, 
                       ULServiceStatus, ULServiceSuspendReason, ULUpdateConfiguration, 
                       ULXPCProtocols ]
...
