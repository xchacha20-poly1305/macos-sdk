--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
install-name:    '/System/Library/PrivateFrameworks/PerfPowerMetricMonitor.framework/Versions/A/PerfPowerMetricMonitor'
exports:
  - targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
    symbols:         [ _PLEmitPowerSignpost, _PLEmitSystemPowerSignpost, _PLLogPower, 
                       _PLLogPowerSignpost, _PPSMetricMonitorLogHandleForCategory, 
                       _PPSTimeStringFromDate, _PerfPowerMetricMonitorVersionNumber, 
                       _PerfPowerMetricMonitorVersionString, _headlessClientId, _kPPSBundleIDKey, 
                       _kPPSCoalitionIDKey, _kPPSInducedThermalPressureKey, _kPPSIsSystemPowerAvailableKey, 
                       _kPPSLiteBundleIDKey, _kPPSLiteCoalitionIDKey, _kPPSLitePidKey, 
                       _kPPSLiteProcessActiveKey, _kPPSLiteProcessMetricsKey, _kPPSLiteProcessNameKey, 
                       _kPPSLiteSampleTimeKey, _kPPSMMConfigEmitSignposts, _kPPSMMConfigEmitTracingSignpost, 
                       _kPPSMMConfigIncludeBackBoardUsage, _kPPSMMConfigIsHeadless, 
                       _kPPSMMConfigLiteMode, _kPPSMMConfigModeKey, _kPPSMMConfigUpdateDelegateKey, 
                       _kPPSMMConfigUpdateIntervalKey, _kPPSMetricMonitorHeadlessServiceName, 
                       _kPPSMetricMonitorServiceName, _kPPSMetricTimestampKey, _kPPSMetricValueKey, 
                       _kPPSPidKey, _kPPSProcessActiveKey, _kPPSProcessMetricsKey, 
                       _kPPSProcessNameKey, _kPPSProcessSampleTimeKey, _kPPSSampleTimeKey, 
                       _kPPSThermalPressureKey, _kPerfPowerMetricMonitorErrorDomain, 
                       _powerMetricsTotalsLogHandle ]
    objc-classes:    [ PPSClient, PPSLiteMetricCollection, PPSLiteProcessMetricCollection, 
                       PPSMetricCollection, PPSMetricMonitor, PPSMetricMonitorConfiguration, 
                       PPSMetricMonitorHeadlessClient, PPSMetricMonitorService, PPSMetricSample, 
                       PPSProcessMetricCollection, PPSSleepWakeInterval ]
...
