--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
install-name:    '/System/Library/PrivateFrameworks/RelativeMotion.framework/Versions/A/RelativeMotion'
exports:
  - targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
    symbols:         [ _kRMErrorDomain ]
    objc-classes:    [ RMAttitude, RMAudioListenerPoseManager, RMConnectionClient, 
                       RMDummyData, RMDummyDataManager, RMInternalServiceClient, 
                       RMLogItem, RMMediaSession, RMMediaSessionOptions, RMPose, 
                       RMRelativeMotionManager ]
...
