--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
install-name:    '/System/Library/PrivateFrameworks/BridgeOSObliteration.framework/Versions/A/BridgeOSObliteration'
exports:
  - targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
    symbols:         [ _BridgeOS_Obliterate, _kDisplayProgressBarKey, _kIgnoreInternalKey, 
                       _kMobileObliterationError, _kMobileObliterationInternalError, 
                       _kMobileObliterationRebootError, _kObliterateDataPartition, 
                       _kObliterateMarkAndReboot, _kObliterationBrickIncludesFirmwareKey, 
                       _kObliterationDelayAfterReplyKey, _kObliterationExclusionPathsKey, 
                       _kObliterationIgnoreMissingPathKey, _kObliterationManagedDeviceWipeKey, 
                       _kObliterationMessageKey, _kObliterationSanitizeStorageKey, 
                       _kObliterationTypeBrickOnly, _kObliterationTypeKey, _kObliterationTypeMarkStart, 
                       _kObliterationTypeRRTS, _kObliterationTypeWipeAndBrick, _kRRTSBootStrapTokenKey, 
                       _kRRTSRevertToSnapshotNameKey, _kSkipDataObliteration ]
...
