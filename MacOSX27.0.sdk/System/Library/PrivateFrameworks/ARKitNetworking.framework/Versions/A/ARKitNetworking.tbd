--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
install-name:    '/System/Library/PrivateFrameworks/ARKitNetworking.framework/Versions/A/ARKitNetworking'
exports:
  - targets:         [ x86_64-macos, arm64e-macos, arm64e.x1-macos ]
    symbols:         [ _ARKitNetworkingVersionNumber, _ARKitNetworkingVersionString, 
                       _ARNetworkingDevicePoseLayoutV1, _ARNetworkingGazeLayoutV1, 
                       _ARNetworkingHandsLayoutV1, _ARNetworkingServiceMinimumCompatibleVersion, 
                       _ARNetworkingServiceNameDevicePose, _ARNetworkingServiceNameGaze, 
                       _ARNetworkingServiceNameHands, _ARNetworkingServiceVersion, 
                       _NSStringFromARNetworkingDataStreamMode, _NSStringFromNWEndpoint ]
    objc-classes:    [ ARNetworkingDataStream, ARNetworkingDeviceClient, ARNetworkingDeviceHost, 
                       ARNetworkingDevicePoseDataReceiver, ARNetworkingGazeDataReceiver, 
                       ARNetworkingHandsDataReceiver, ARNetworkingServer, ARNetworkingWeakObserverCollection ]
...
