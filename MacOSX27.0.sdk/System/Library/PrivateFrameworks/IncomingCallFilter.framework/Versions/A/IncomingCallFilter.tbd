                   arm64e.x1-macos, arm64e.x1-maccatalyst ]
install-name:    '/System/Library/PrivateFrameworks/IncomingCallFilter.framework/Versions/A/IncomingCallFilter'
current-version: 800
exports:
  - targets:         [ x86_64-macos, x86_64-maccatalyst, arm64e-macos, arm64e-maccatalyst, 
                       arm64e.x1-macos, arm64e.x1-maccatalyst ]
    symbols:         [ _ICFCallProviderShouldAllowIncomingCall, _ICFCallProviderShouldAllowIncomingCallWithQueue, 
                       _ICFCallProviderShouldAllowIncomingGroupCallWithQueue, _ICFRegisterCallFilterBlockWithIdentifier, 
                       _ICFRegisterCallFilterResultBlockWithIdentifier, _ICFServiceIdentifierFaceTime, 
                       _ICFServiceIdentifierFaceTimeAudio, _ICFServiceIdentifierTelephony, 
                       _ICFServiceIdentifierTelephonyRelay, _ICFUnknownID, _ICFUnregisterCallFilterBlockWithIdentifier, 
                       _ICFUnregisterCallFilterResultBlockWithIdentifier ]
    objc-classes:    [ ICFCallServer ]
...
