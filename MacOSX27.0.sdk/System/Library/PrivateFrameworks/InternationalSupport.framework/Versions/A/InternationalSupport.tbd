--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, x86_64-maccatalyst, arm64e-macos, arm64e-maccatalyst, 
                   arm64e.x1-macos, arm64e.x1-maccatalyst ]
install-name:    '/System/Library/PrivateFrameworks/InternationalSupport.framework/Versions/A/InternationalSupport'
current-version: 74
swift-abi-version: 7
exports:
  - targets:         [ x86_64-macos, x86_64-maccatalyst, arm64e-macos, arm64e-maccatalyst, 
                       arm64e.x1-macos, arm64e.x1-maccatalyst ]
    symbols:         [ _ISBackstopLanguage, _ISBackstopLocale, _ISEnumerateKnownUrduSequencesInString, 
                       _ISLanguageDidChangeDarwinNotification, _InternationalSupportVersionNumber, 
                       _InternationalSupportVersionString ]
    objc-classes:    [ ISLanguageCarousel, ISLanguageCarouselItem, ISUtilities ]
...
