--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, x86_64-maccatalyst, arm64e-macos, arm64e-maccatalyst, 
                   arm64e.x1-macos, arm64e.x1-maccatalyst ]
install-name:    '/System/Library/PrivateFrameworks/FindMyDevice.framework/Versions/A/FindMyDevice'
exports:
  - targets:         [ x86_64-macos, x86_64-maccatalyst, arm64e-macos, arm64e-maccatalyst, 
                       arm64e.x1-macos, arm64e.x1-maccatalyst ]
    symbols:         [ _FMDCoverageOptionsFromInternal, _FMDFMIPManagerUnregisterErrorDomain, 
                       _FMDFMMManagerUnregisterErrorDomain, _FMDLostModeExitAuthCompleteNotification, 
                       _FMDSecureLocationsReceivedCommandNotification, _FMDSecureLocationsReceivedPayloadNotification, 
                       _FMDSharedConfigurationKeyCoverage, _FMDTheftAndLossCoverageInternalFromPublic, 
                       _fmdFMMLastOperationResult, _kAccessoriesChangedNotification, 
                       _kActivationLockAllowedMayHaveChangedNotification, _kActivationLockStateDidChangeNotification, 
                       _kFMDAccessoryPlaySoundErrorDomain, _kFMDActivationLockInfoDescriptionKey, 
                       _kFMDActivationLockInfoTitleKey, _kFMDActivationLockStateChangedNotification, 
                       _kFMDErrorDomain, _kFMDFMIPAccountNameKey, _kFMDFMIPAccountPersonIDKey, 
                       _kFMDFMMNeedsLostModeExitAuth, _kFMDFMMUAServicesAccessEntitlement, 
                       _kFMDFMMUserAgentAccessEntitlement, _kFMDLocalActivationLockInfoChangedNotification, 
                       _kFMDLogPrefsChangedDarwinNotification, _kFMDNotBackedUpMagSafePrefDomain, 
                       _kFMDNotBackedUpPrefDomain, _kFMDOfflineFindingInfoChangedNotification, 
                       _kFMDOptionsActivationLockPET, _kFMDOptionsActivationLockUsername, 
                       _kFMDPlaySoundStartedDarwinNotification, _kFMDPlaySoundStoppedDarwinNotification, 
                       _kFMDPostWipePrefDomain, _kFMDPrefDomain, _kFMDPublicNotBackedUpPrefDomain, 
                       _kFMDSecureLocationModeBackgroundProactive, _kFMDSecureLocationModeLive, 
                       _kFMDSecureLocationModeOwnerProactive, _kFMDSecureLocationModeProactive, 
                       _kFMDSecureLocationModeProactiveShallow, _kFMDSharedConfigurationConfigVersionKey, 
                       _kFMDSharedConfigurationDataKey, _kFMDSharedConfigurationExpiryKey, 
                       _kFMDSharedConfigurationLastRequestedKey, _kFMDSharedConfigurationXPCServiceAccessEntitlement, 
                       _kFMDStartupCompleteNotification, _kFMDUserAgentPrefDomain, 
                       _kFMDWatchNotBackedUpPrefDomain, _kFMDWatchPrefDomain, _kFMIPAppBundleIdentifier, 
                       _kFMIPLocatableStateReportedNotification, _kFMIPLowBatteryLocateStateDidChangeNotification, 
                       _kFMIPStateDidChangeNotification, _kFMMActivationLockEnabledPrefKey, 
                       _kFMMAuthRight, _kFMMEnabledPrefDomain, _kFMMEnabledPrefKey, 
                       _kFMMLocateAlertPendingNotification, _kFMMRemoveAuthRight, 
                       _kFMMUCRTUnlockPendingPrefKey, _kFMWEnabledNotification, _kFindMyDeviceEmergencyCallInfoPublisherXPCInterfaceErrorDomain, 
                       _kFindMyDeviceIdentityXPCInterfaceErrorDomain, _kLostModeChangedRestrictedNotification, 
                       _kStopLostModeAlarmNotification ]
    objc-classes:    [ FMDAccessoryIdentifier, FMDActivationLockContext, FMDActivationLockInfo, 
                       FMDAudioAccessoryInfo, FMDBAAAttestation, FMDCommandValidationSignatureRequestContext, 
                       FMDDeviceIdentityFactory, FMDEraseOptions, FMDEraseProxy, 
                       FMDFMIPAccountInfo, FMDFMMAccountInfo, FMDFMMManager, FMDIdentitySigningRequest, 
                       FMDLocalFindableAccessory, FMDRepairDevice, FMDRepairDeviceContext, 
                       FMDRepairDeviceLookupContext, FMDRepairDeviceLookupResult, 
                       FMDRepairDeviceResult, FMDSharedConfiguration, FMDSharedConfigurationEntry, 
                       FMDSharedConfigurationFollowUpEntry, FMDShouldDisableResult, 
                       FMDVolatileMetaDataRecord, FMNSXPCConnection, FMNSXPCConnectionCache, 
                       FMNSXPCConnectionConfiguration ]
...
