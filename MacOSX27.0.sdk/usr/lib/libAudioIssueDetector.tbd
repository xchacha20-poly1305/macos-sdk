--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, x86_64-maccatalyst, arm64e-macos, arm64e-maccatalyst, 
                   arm64e.x1-macos, arm64e.x1-maccatalyst ]
install-name:    '/usr/lib/libAudioIssueDetector.dylib'
exports:
  - targets:         [ x86_64-macos, x86_64-maccatalyst, arm64e-macos, arm64e-maccatalyst, 
                       arm64e.x1-macos, arm64e.x1-maccatalyst ]
    symbols:         [ _AudioDataAnalysisManagerConnectedWiredDeviceIsHeadphone, 
                       _AudioDataAnalysisManagerCreate, _AudioDataAnalysisManagerCreateNodeEnvSPL, 
                       _AudioDataAnalysisManagerCreateNodeEnvSoundClass, _AudioDataAnalysisManagerCreateNodeMediaLevel, 
                       _AudioDataAnalysisManagerCreateNodeMicLevel, _AudioDataAnalysisManagerCreateNodePCM, 
                       _AudioDataAnalysisManagerCreateNodeSPL, _AudioDataAnalysisManagerDispose, 
                       _AudioDataAnalysisManagerInitialize, _AudioDataAnalysisManagerIsSessionInitialized, 
                       _AudioDataAnalysisManagerProcessAudio, _AudioDataAnalysisManagerProcessEnvSPL, 
                       _AudioDataAnalysisManagerProcessEnvSoundClass, _AudioDataAnalysisManagerProcessMediaLevel, 
                       _AudioDataAnalysisManagerProcessMicLevel, _AudioDataAnalysisManagerProcessSPL, 
                       _AudioDataAnalysisManagerRegisterDeviceInfo, _AudioDataAnalysisManagerRemoveNode, 
                       _AudioDataAnalysisManagerReset, _AudioDataAnalysisManagerSetApplicationBundleID, 
                       _AudioDataAnalysisManagerSetDeviceConnectionState, _AudioDataAnalysisManagerSetDeviceInfo, 
                       _AudioDataAnalysisManagerStartServices, _AudioDataAnalysisManagerUpdateReportingSessions, 
                       _AudioIssueDetectorAnalyzeBuffer, _AudioIssueDetectorCreate, 
                       _AudioIssueDetectorDispose, _AudioIssueDetectorFlush, _AudioIssueDetectorInitialize, 
                       _AudioIssueDetectorRemoveNode, _AudioIssueDetectorReset, _AudioIssueDetectorSetDownlinkVolume, 
                       _AudioIssueDetectorSetNodeFormat, _AudioIssueDetectorSetNodeFormatWithDirection, 
                       _AudioIssueDetectorSetRouteSpecificDownlinkGainAdjustment, 
                       _AudioIssueDetectorSetSmartCaseMicMute, _AudioIssueDetectorSetUplinkMute, 
                       _AudioIssueDetectorUpdateReportingSessions, _EnvironmentalDosimetryAgentCreate, 
                       _EnvironmentalDosimetryAgentDispose ]
...
